<?xml version="1.0" encoding="UTF-8"?>
<!-- cmdline корня — командная строка ЯДРА (BootInfo.cmdline):
     meltdown=allow нужен под QEMU/TCG (эмулятор не сообщает RDCL_NO
     и не имеет спекулятивной утечки); на реальном железе БЕЗ KPTI
     ядро обязано отказывать в загрузке — не ставьте этот флаг. -->
<boot cmdline="arch=x86_64 console=com1 meltdown=allow">
  <servers>
    <!-- init: первый сервер (обязателен, модуль [0] протокола). -->
    <server name="init" path="init">
      <arg>--demo</arg>
      <arg>stage0</arg>
    </server>
  </servers>
  <boot_state>
    <!-- Переменные загрузки: транзитом init через стартовый IPC. -->
    <var name="console" value="com1"/>
    <var name="root" value="nvme0"/>
    <var name="boot_mode" value="normal"/>
    <var name="splash" value="off"/>
  </boot_state>
</boot>
