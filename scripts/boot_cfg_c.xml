<?xml version="1.0" encoding="UTF-8"?>
<!-- ==== boot_cfg_c.xml: конфигурация C-сервера (схема v3) ====
     Демонстрация userlib: init-сервером становится capp (чистый C через
     libuserlib.a). В v3 серверы живут в boot-архиве RLBA — чтобы
     поднять capp первым, mkarchive.py собирает архив с
     --init target/.../capp (INIT-запись каталога). -->
<bootloader timeout="0" default="capp-chain">
  <payload id="capp-chain" type="rust-l4" title="C reference (capp)"
           cmdline="arch=x86_64 console=com1 meltdown=allow"
           archive="boot_capp.cpio">
    <boot_state>
      <var name="console" value="com1"/>
      <var name="boot_mode" value="normal"/>
    </boot_state>
  </payload>
</bootloader>
